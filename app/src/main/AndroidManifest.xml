<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core capture. RECORD_AUDIO is only ever used inside a user-started,
         foreground-service-backed listening session (docs/SECURITY.md §9). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service of type microphone (Android 14+ requires the typed
         permission). The service runs ONLY during an explicit session. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Long local inference promoted by WorkManager while the UI is closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Opt-in "Automazioni attive" observer: no built-in type fits "watch device
         events", so it declares the special-use type. It does no polling. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notifications for the foreground service (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bluetooth: connect is needed to route audio to AirPods and read device
         names. No location is requested: we do not scan for discovery. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Optional companion-PC / Home Assistant connectivity. The offline path
         never needs the network; these are used only when explicitly enabled. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Offline navigation: GNSS position (works with no network) and a typed
         foreground service so navigation continues with the screen off. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Short haptic when a voice reply lands while the chat is closed. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Reminders and time automations are promises about a specific minute, so
         they use AlarmManager rather than deferrable work. USE_EXACT_ALARM is
         granted at install for an alarm-shaped app; SCHEDULE_EXACT_ALARM is the
         Android 12 fallback, and a denial degrades to an inexact alarm rather
         than dropping it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Alarms do not survive a reboot; the schedule is rebuilt from the files. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Phase 6 tools: set timers/alarms in the system clock app without opening its UI. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Deliberately NOT requested: MANAGE_EXTERNAL_STORAGE, QUERY_ALL_PACKAGES,
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, any Accessibility service. See
         docs/PRIVACY.md and docs/SECURITY.md. -->

    <!-- Make the on-device speech recognition service visible (Android 11+ package
         visibility). Used by the offline SpeechRecognizer (Phase 2). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.android.chrome" />
        <package android:name="md.obsidian" />
    </queries>

    <application
        android:name=".JarvisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisMobile"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisMobile.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Qualifies the visible Activity for Android's Assistant role.
                 The system gesture/button opens JARVIS and starts one explicit
                 listening session; there is no always-on microphone. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Safe internal deep links: jarvis://listen and jarvis://voice
                 start an explicit listening session; jarvis://chat opens the chat
                 (docs/ARCHITECTURE.md §7.4). Stop is a broadcast, not a screen. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvis" android:host="listen" />
                <data android:scheme="jarvis" android:host="voice" />
                <data android:scheme="jarvis" android:host="chat" />
            </intent-filter>
        </activity>

        <!-- Foreground listening service. Started only by explicit user action. -->
        <service
            android:name=".audio.ListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Offline navigation foreground service: keeps guidance running with the
             screen off. Runs only during an active trip. -->
        <service
            android:name=".navigation.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Opt-in observer that lets device-event automations fire with the app
             closed. specialUse: it watches system broadcasts (unlock, headset,
             airplane/Wi-Fi) that are delivered only to a live process. No polling,
             no mic, no location. A minimal, silent notification is required by the
             platform. -->
        <service
            android:name=".automation.AutomationEventService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Osserva gli eventi del telefono per le automazioni scelte dall'utente" />
        </service>

        <receiver
            android:name=".background.CancelTaskReceiver"
            android:exported="false" />

        <!-- Widget/notification "Stop" action: cancels generation/TTS/voice
             without opening the app. -->
        <receiver
            android:name=".widget.JarvisActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.simone.jarvismobile.action.STOP" />
            </intent-filter>
        </receiver>

        <!-- Condition automations. Android has no per-percent broadcast a
             manifest may declare, so battery thresholds are evaluated at the
             moments the system does wake us: charger in/out and its own low
             battery warning. -->
        <receiver
            android:name=".alarms.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.simone.jarvismobile.ALARM_FIRE" />
                <data android:scheme="jarvis" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".alarms.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- "Non avvisarmi più di questo" action on a proactive suggestion. -->
        <receiver
            android:name=".proactive.ProactiveActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.simone.jarvismobile.action.PROACTIVE_MUTE" />
            </intent-filter>
        </receiver>

        <!-- Reminder shade action: mark the item completed. -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.simone.jarvismobile.action.REMINDER_DONE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".automation.PowerEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tools.JarvisNotificationListener"
            android:exported="true"
            android:label="JARVIS — accesso notifiche"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- WorkManager promotes long on-device inference to a visible data-sync
             foreground service when the Activity is no longer visible. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|mediaPlayback"
            tools:node="merge" />

        <!-- Home-screen widgets (Jetpack Glance). Each only fires an existing
             deep link / broadcast; none records or holds state of its own. -->
        <receiver
            android:name=".widget.JarvisVoiceWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jarvis_voice_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.JarvisChatWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jarvis_chat_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.JarvisControlWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jarvis_control_widget_info" />
        </receiver>

        <!-- Quick Settings tile (Android 7+). Opens an explicit session; it never
             records silently (docs/ARCHITECTURE.md §7.2). -->
        <service
            android:name=".tile.JarvisTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_jarvis"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

    </application>
</manifest>
