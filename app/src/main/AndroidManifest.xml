<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core capture. RECORD_AUDIO is only ever used inside a user-started,
         foreground-service-backed listening session (docs/SECURITY.md §9). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service of type microphone (Android 14+ requires the typed
         permission). The service runs ONLY during an explicit session. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Long local inference promoted by WorkManager while the UI is closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Opt-in "Automazioni attive" observer: no built-in type fits "watch device
         events", so it declares the special-use type. It does no polling. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notifications for the foreground service (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Modalità Guida: draws the small overlay windows over Google Maps
         (docs "Driving Mode"). Requested explicitly via Settings.canDrawOverlays()
         before the overlay is ever shown; never assumed granted. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Lets JARVIS modes set Do-Not-Disturb (SLEEP = Zen: silence noise, keep
         alarms and priority calls). The user still grants DND access in system
         settings; without it a mode sets only the ringer and says so. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Bluetooth: connect is needed to route audio to AirPods and read device
         names. No location is requested: we do not scan for discovery. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Optional companion-PC / Home Assistant connectivity. The offline path
         never needs the network; these are used only when explicitly enabled. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Offline navigation: GNSS position (works with no network) and a typed
         foreground service so navigation continues with the screen off. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Place-based automations ("quando arrivo a <luogo>"). The context engine's
         CapabilityManager already gates place rules on this grant, but without
         declaring it the grant can never be given, so a geofence rule looked
         armed while it could never fire in the background. Requested only after
         the foreground grant, and only when the user opts a place rule in; the OS
         evaluates the geofence on-device — no continuous tracking, no network. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Short haptic when a voice reply lands while the chat is closed. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Reminders and time automations are promises about a specific minute, so
         they use AlarmManager rather than deferrable work. USE_EXACT_ALARM is
         granted at install for an alarm-shaped app; SCHEDULE_EXACT_ALARM is the
         Android 12 fallback, and a denial degrades to an inexact alarm rather
         than dropping it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Alarms do not survive a reboot; the schedule is rebuilt from the files. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Phase 6 tools: set timers/alarms in the system clock app without opening its UI. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Health Connect (opt-in, tema Ares > blocco Sistema): read-only, and only
         the two metrics the block actually shows — no step count, no weight,
         no other health data. Requested at runtime via PermissionController,
         never assumed granted; JARVIS never writes to Health Connect.
         READ_RESTING_HEART_RATE, non READ_HEART_RATE (§ bug reale trovato dal
         confronto diretto con Honor Health: quando HealthConnectManager.kt è
         passato a RestingHeartRateRecord, questa dichiarazione — e l'array
         health_permissions.xml gemello per il meta-data dell'activity-alias —
         non erano state aggiornate di conseguenza, quindi Health Connect non
         offriva mai all'utente il permesso giusto da concedere). -->
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- § FASE 2A.8 RELEASE GATE E/G audit — a plain, dangerous-protection
         Android permission (not requested via HealthPermission.getReadPermission,
         so deliberately NOT in health_permissions.xml's array — that array's own
         doc comment says every entry there matches a per-record permission
         string, which this is not). Needed only by the new WorkManager-based
         post-briefing health refresh (§F/§G): the existing foreground read
         (ProactiveManager.snapshot() at the real first unlock, already
         working on-device) never needed it. Declaring it here does NOT grant
         it — HealthConnectManager.hasBackgroundPermission() checks it
         explicitly before any background read is attempted, and that refresh
         degrades to "skip, try again later" rather than crashing or guessing
         when it is missing (see HealthConnectManager.kt). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Deliberately NOT requested: MANAGE_EXTERNAL_STORAGE, QUERY_ALL_PACKAGES,
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, any Accessibility service. See
         docs/PRIVACY.md and docs/SECURITY.md. -->

    <!-- Make the on-device speech recognition service visible (Android 11+ package
         visibility). Used by the offline SpeechRecognizer (Phase 2). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.android.chrome" />
        <package android:name="md.obsidian" />
        <!-- Health Connect app itself (pre-Android 14 devices install it
             separately from Play Store; Android 14+ has it built in but the
             package check still needs this declared to see it). Nuova
             ipotesi non ancora verificata (§ "ancora non riesco a
             collegare health connect"): sui build Android 14+ il modulo
             potrebbe girare sotto un package diverso da quello Play Store
             standalone — dichiarato anche in via precauzionale, un
             <queries><package> in più che non esiste sul device è
             innocuo, non un'altra modifica di logica alla cieca. -->
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.google.android.healthconnect.controller" />
    </queries>

    <application
        android:name=".JarvisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisMobile"
        tools:targetApi="31">

        <!--
          Bug reale segnalato dall'utente da dispositivo: "Concedi accesso"
          per Health Connect si apriva e chiudeva subito con 0 permessi
          concessi, senza mostrare mai la schermata reale — e J.A.R.V.I.S.
          non compariva affatto nell'elenco "Autorizzazioni app" di Health
          Connect (verificato con screenshot dell'utente: Health Sync,
          Honor Health, Automate, Claude, Home Assistant, Starfit erano
          tutte elencate, JARVIS no). Le sole voci <uses-permission>
          android.permission.health.* non bastano perché Health Connect
          possa riconoscere e registrare l'app come richiedente valido:
          serve anche questo meta-dato che punta all'elenco esplicito dei
          permessi (res/values/health_connect.xml), esattamente gli stessi
          due che HealthConnectManager.kt richiede via
          HealthPermission.getReadPermission(...).
        -->
        <meta-data
            android:name="health_permissions"
            android:resource="@array/health_permissions" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisMobile.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Qualifies the visible Activity for Android's Assistant role.
                 The system gesture/button opens JARVIS and starts one explicit
                 listening session; there is no always-on microphone. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Safe internal deep links: jarvis://listen and jarvis://voice
                 start an explicit listening session; jarvis://chat opens the chat
                 (docs/ARCHITECTURE.md §7.4). Stop is a broadcast, not a screen. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvis" android:host="listen" />
                <data android:scheme="jarvis" android:host="voice" />
                <data android:scheme="jarvis" android:host="chat" />
            </intent-filter>
        </activity>

        <!--
          § indagine Health Connect proseguita: JARVIS assente dall'elenco
          "Autorizzazioni app" nonostante il meta-dato health_permissions
          qui sopra (verificato presente e corretto nell'APK decompilato in
          un giro precedente) — quel meta-dato da solo copre solo la vecchia
          via di dichiarazione, non basta. Requisito distinto e documentato
          di Health Connect, mai provato prima in questo progetto: un
          activity-alias con un intent-filter su
          android.intent.action.VIEW_PERMISSION_USAGE + la categoria
          android.intent.category.HEALTH_PERMISSIONS — è ciò che permette a
          Health Connect di elencare l'app fra i richiedenti validi e di
          mostrare "Perché la mia app ha bisogno di questi permessi" quando
          l'utente tocca l'app nell'elenco. Punta alla stessa MainActivity
          già esportata, non una schermata nuova.
        -->
        <activity-alias
            android:name=".health.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Driving Mode V2: the new in-app INTERNAL_JARVIS_NAVIGATION screen — a
             real Activity, not a system overlay. Reachable only from the
             developer feature flag while it's being built (docs/ARCHITECTURE.md);
             EXTERNAL_MAPS_OVERLAY (DrivingModeService below) is untouched and
             stays the default. -->
        <activity
            android:name=".driving.DrivingModeActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisMobile" />

        <!-- Foreground listening service. Started only by explicit user action. -->
        <service
            android:name=".audio.ListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Offline navigation foreground service: keeps guidance running with the
             screen off. Runs only during an active trip. -->
        <service
            android:name=".navigation.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Modalità Guida overlay (docs "Driving Mode"). specialUse: no built-in
             FGS type fits "small overlay windows over another app"; the property
             below is the justification Android 14+ requires. microphone: with no
             visible Activity (Maps owns the foreground, not JARVIS), the wake word's
             mic access needs its own qualifying foreground-service type or Android's
             background-mic restriction silently blocks it — the same reason
             ListeningService declares it. Started only by an explicit user action
             (Home button, voice command, or a rule the user created) and always
             shows the persistent notification below. -->
        <service
            android:name=".driving.DrivingModeService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Overlay JARVIS su Google Maps durante la Modalità Guida scelta dall'utente" />
        </service>

        <!-- Opt-in observer that lets device-event automations fire with the app
             closed. specialUse: it watches system broadcasts (unlock, headset,
             airplane/Wi-Fi) that are delivered only to a live process. No polling,
             no mic, no location. A minimal, silent notification is required by the
             platform. -->
        <service
            android:name=".automation.AutomationEventService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Osserva gli eventi del telefono per le automazioni scelte dall'utente" />
        </service>

        <!-- Archivio locale (§ richiesta esplicita dell'utente: consultare,
             scaricare o condividere fuori da JARVIS i propri file importati).
             Exposes only files/documents/ (see file_paths.xml) as content://
             URIs — the standard, sandboxed way to hand an app-private file to
             another app's share sheet without a broad storage permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".background.CancelTaskReceiver"
            android:exported="false" />

        <!-- Widget/notification "Stop" action: cancels generation/TTS/voice
             without opening the app. -->
        <receiver
            android:name=".widget.JarvisActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.simone.jarvismobile.action.STOP" />
            </intent-filter>
        </receiver>

        <!-- Condition automations. Android has no per-percent broadcast a
             manifest may declare, so battery thresholds are evaluated at the
             moments the system does wake us: charger in/out and its own low
             battery warning. -->
        <receiver
            android:name=".alarms.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.simone.jarvismobile.ALARM_FIRE" />
                <data android:scheme="jarvis" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".alarms.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- § FASE 2A.8 §F — Multi-Signal Morning Coordinator's NEXT_ALARM
             signal: reschedules its exact alarm promptly when the device's
             next alarm changes (see NextAlarmChangedReceiver's own honesty
             note on this broadcast's reliability across OEM builds). -->
        <receiver
            android:name=".proactive.NextAlarmChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- "Non avvisarmi più di questo" action on a proactive suggestion. -->
        <receiver
            android:name=".proactive.ProactiveActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.simone.jarvismobile.action.PROACTIVE_MUTE" />
            </intent-filter>
        </receiver>

        <!-- Reminder shade action: mark the item completed. -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.simone.jarvismobile.action.REMINDER_DONE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".automation.PowerEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
            </intent-filter>
        </receiver>

        <!-- Where an OS proximity alert lands for a saved place (phase 6). Not
             exported: only the system's LocationManager delivers to it, via the
             explicit PendingIntent the geofence source registers. -->
        <receiver
            android:name=".automation.rule.PlaceProximityReceiver"
            android:exported="false" />

        <!-- Charger connect/disconnect for the generic engine. POWER_CONNECTED/
             DISCONNECTED are protected broadcasts the system delivers to a
             manifest receiver even when the app is stopped. Separate from the old
             engine's PowerEventReceiver. -->
        <receiver
            android:name=".automation.rule.EnginePowerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tools.JarvisNotificationListener"
            android:exported="true"
            android:label="JARVIS — accesso notifiche"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- WorkManager promotes long on-device inference to a visible data-sync
             foreground service when the Activity is no longer visible. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|mediaPlayback"
            tools:node="merge" />

        <!-- Home-screen widgets (Jetpack Glance). Each only fires an existing
             deep link / broadcast; none records or holds state of its own. -->
        <receiver
            android:name=".widget.JarvisVoiceWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jarvis_voice_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.JarvisChatWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jarvis_chat_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.JarvisControlWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jarvis_control_widget_info" />
        </receiver>

        <!-- Quick Settings tile (Android 7+). Opens an explicit session; it never
             records silently (docs/ARCHITECTURE.md §7.2). -->
        <service
            android:name=".tile.JarvisTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_jarvis"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

    </application>
</manifest>
