{
  "version": 8,
  "name": "JARVIS Navigation",
  "metadata": { "jarvis:theme": "dark-night" },
  "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "jarvis-region": {
      "type": "vector",
      "url": "pmtiles://LOCAL_REGION_PLACEHOLDER"
    },
    "jarvis-traffic": {
      "type": "vector",
      "tiles": ["https://TRAFFIC_TILE_PLACEHOLDER/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 22
    },
    "jarvis-route-src": {
      "type": "geojson",
      "data": { "type": "FeatureCollection", "features": [] }
    },
    "jarvis-route-traversed-src": {
      "type": "geojson",
      "data": { "type": "FeatureCollection", "features": [] }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#10161F" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "jarvis-region",
      "source-layer": "water",
      "paint": { "fill-color": "#152232" }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "jarvis-region",
      "source-layer": "landuse",
      "minzoom": 8,
      "paint": { "fill-color": "#161F2B", "fill-opacity": 0.6 }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "jarvis-region",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#2A3644", "fill-opacity": 0.85 }
    },
    {
      "id": "buildings-outline",
      "type": "line",
      "source": "jarvis-region",
      "source-layer": "building",
      "minzoom": 15,
      "paint": { "line-color": "#3B4A5C", "line-width": 0.6, "line-opacity": 0.6 }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "jarvis-region",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "minzoom": 12,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3A4656",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 16, 1.6, 18, 5]
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "jarvis-region",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#5E7086",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 2.2, 18, 8]
      }
    },
    {
      "id": "roads-primary",
      "type": "line",
      "source": "jarvis-region",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "trunk"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#8CA0B8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.8, 14, 3.2, 18, 11]
      }
    },
    {
      "id": "roads-motorway",
      "type": "line",
      "source": "jarvis-region",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#C3D0E0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 14, 4, 18, 15]
      }
    },
    {
      "id": "traffic-flow",
      "type": "line",
      "source": "jarvis-traffic",
      "source-layer": "Traffic flow",
      "minzoom": 5,
      "layout": { "visibility": "none", "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.2, 14, 4.5, 18, 13],
        "line-opacity": 0.9,
        "line-color": [
          "interpolate", ["linear"], ["coalesce", ["to-number", ["get", "traffic_level"]], 0],
          0, "#2ECC71",
          0.5, "#F5A623",
          0.8, "#E23A2E",
          1, "#8B1A1A"
        ]
      }
    },
    {
      "id": "route-glow",
      "type": "line",
      "source": "jarvis-route-src",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#E23A2E",
        "line-width": 16,
        "line-opacity": 0.18,
        "line-blur": 6
      }
    },
    {
      "id": "route-outline",
      "type": "line",
      "source": "jarvis-route-src",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#173A5E",
        "line-width": 9
      }
    },
    {
      "id": "route-main",
      "type": "line",
      "source": "jarvis-route-src",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#4FD1E0",
        "line-width": 5
      }
    },
    {
      "id": "route-traversed",
      "type": "line",
      "source": "jarvis-route-traversed-src",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3A4656",
        "line-width": 5,
        "line-opacity": 0.85
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "jarvis-region",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#D9DEE3",
        "text-halo-color": "#10161F",
        "text-halo-width": 1.4
      }
    }
  ]
}
