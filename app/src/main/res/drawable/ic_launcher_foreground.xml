<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      The JARVIS orb, centred on 54,54 and kept inside the adaptive-icon safe
      zone (the central ~66dp circle): concentric HUD rings, four cardinal
      ticks and a glowing reactor core. Cyan on the dark launcher background,
      coherent with the in-app orb. The single-colour paths also make a clean
      monochrome (themed) icon.
    -->

    <!-- Soft outer halo. -->
    <path
        android:fillColor="#1A4FD1E0"
        android:pathData="M54,20 a34,34 0 1,0 0.01,0 z" />

    <!-- Outer ring. -->
    <path
        android:strokeColor="#4FD1E0"
        android:strokeWidth="2.2"
        android:fillColor="#00000000"
        android:pathData="M54,25 a29,29 0 1,0 0.01,0 z" />

    <!-- Inner ring. -->
    <path
        android:strokeColor="#3FBFD8"
        android:strokeWidth="1.4"
        android:fillColor="#00000000"
        android:pathData="M54,31 a23,23 0 1,0 0.01,0 z" />

    <!-- Cardinal ticks (top, bottom, left, right). -->
    <path
        android:strokeColor="#7FE9F5"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M54,24 L54,30 M54,78 L54,84 M24,54 L30,54 M78,54 L84,54" />

    <!-- Core glow. -->
    <path
        android:fillColor="#334FD1E0"
        android:pathData="M54,40 a14,14 0 1,0 0.01,0 z" />

    <!-- Reactor core. -->
    <path
        android:fillColor="#8FF0FA"
        android:pathData="M54,47 a7,7 0 1,0 0.01,0 z" />
</vector>
