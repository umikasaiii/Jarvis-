<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The JARVIS dragon logo, full-bleed as the background so the whole emblem
         shows through the launcher mask (a foreground would crop it at the safe
         zone). Foreground is transparent; the monochrome vector drives the
         themed (tinted) icon, which a raster cannot. -->
    <background android:drawable="@drawable/jarvis_dragon" />
    <foreground android:drawable="@android:color/transparent" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
