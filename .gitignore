# Gradle
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Android / IDE
local.properties
.idea/
*.iml
captures/
.cxx/
release/

# Kotlin/Java
*.class
*.log
*.hprof

# Python (tools/navigation/osm_to_jarvis.py)
__pycache__/
*.pyc

# Secrets & personal data — never commit (docs/SECURITY.md, docs/PRIVACY.md)
*.keystore
*.jks
# Exception: the DEBUG-only keystore is committed on purpose so every CI build is
# signed with the same key and updates install over each other. It is NOT a
# release key and holds no secret (standard debug password "android").
!app/debug.keystore
keystore.properties
keystore.properties.local
*-credentials.txt
jarvis-release*
secrets.properties
.env
*.env
server/.env

# Models & personal audio — never commit (docs/MODELS.md)
*.gguf
*.onnx
*.bin
*.wav
!app/src/test/resources/fixtures/*.wav
!core/src/test/resources/fixtures/*.wav
# Imported model files live at the repo root only; anchor so this does NOT match
# the source package app/.../ui/models/.
/models/

# OS
.DS_Store
Thumbs.db

# Kotlin compiler
.kotlin/
