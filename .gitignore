# Gradle
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Android / IDE
local.properties
.idea/
*.iml
captures/
.cxx/
release/

# Kotlin/Java
*.class
*.log
*.hprof

# Python (tools/navigation/osm_to_jarvis.py)
__pycache__/
*.pyc

# § PASSAGGIO 14B — real EmbeddingGemma model/tokenizer artifacts and their
# run output are large binaries + a user's local machine state, never
# committed (docs/JARVIS_MASTER_ARCHITECTURE.md §51-style rule: large
# artifacts stay local). The manifest/reports THEMSELVES are small JSON and
# not excluded by this rule — only the model/tokenizer files and generated
# run directories underneath them.
tools/semantic_classifier/models/*
!tools/semantic_classifier/models/README.md
tools/semantic_classifier/real_run/
tools/semantic_classifier/.venv_pass14b/
tools/semantic_classifier/*.tflite
tools/semantic_classifier/*.task
tools/semantic_classifier/embedding_cache*.json
tools/semantic_classifier/*_qualification_report.json
tools/semantic_classifier/artifact_manifest.json
tools/semantic_classifier/*.selftest.json

# Secrets & personal data — never commit (docs/SECURITY.md, docs/PRIVACY.md)
*.keystore
*.jks
# Exception: the DEBUG-only keystore is committed on purpose so every CI build is
# signed with the same key and updates install over each other. It is NOT a
# release key and holds no secret (standard debug password "android").
!app/debug.keystore
keystore.properties
keystore.properties.local
*-credentials.txt
jarvis-release*
secrets.properties
.env
*.env
server/.env

# Models & personal audio — never commit (docs/MODELS.md)
*.gguf
*.onnx
*.bin
*.wav
!app/src/test/resources/fixtures/*.wav
!core/src/test/resources/fixtures/*.wav
# Imported model files live at the repo root only; anchor so this does NOT match
# the source package app/.../ui/models/.
/models/

# OS
.DS_Store
Thumbs.db

# Kotlin compiler
.kotlin/
