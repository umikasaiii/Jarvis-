# Release signing config for JARVIS Mobile (app/build.gradle.kts).
#
# Copy this file to `keystore.properties` (repo root, already gitignored) and
# fill in the real values. NEVER commit the filled-in file or the .jks itself
# — both are covered by .gitignore (*.jks, keystore.properties). Alternatively,
# set the equivalent JARVIS_RELEASE_STORE_FILE / _STORE_PASSWORD / _KEY_ALIAS /
# _KEY_PASSWORD environment variables (e.g. for CI) instead of this file.
#
# storeFile may be relative to the repo root or an absolute path — keep the
# real .jks outside the repository either way.

storeFile=/absolute/path/to/jarvis-release.jks
storePassword=REPLACE_ME
keyAlias=jarvis-release
keyPassword=REPLACE_ME
